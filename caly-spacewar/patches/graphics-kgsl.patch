 	unsigned int id, i;
 
-	if (copy_struct_from_user(&sync, sizeof(sync), data, datasize))
+	if (caly_copy_struct_from_user(&sync, sizeof(sync), data, datasize))
 		return -EFAULT;
 
 	kref_get(&drawobj->refcount);
@@ -766,7 +786,7 @@ static int drawobj_add_sync_timestamp_from_user(struct kgsl_device *device,
 {
