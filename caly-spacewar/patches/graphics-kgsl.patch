diff --git a/kgsl_drawobj.c b/kgsl_drawobj.c
index eaac2fc..3e42f32 100644
--- a/kgsl_drawobj.c
+++ b/kgsl_drawobj.c
@@ -28,6 +28,26 @@
 #include "kgsl_drawobj.h"
 #include "kgsl_eventlog.h"
 #include "kgsl_sync.h"
+
+static inline int caly_copy_struct_from_user(void *dst, size_t ksize,
+		const void __user *src, size_t usize)
+{
+	size_t copy = ksize < usize ? ksize : usize;
+	static int caly_sz_logged;
+
+	if (usize != ksize && caly_sz_logged < 6) {
+		caly_sz_logged++;
+		pr_emerg("CALY_KGSL_CPY: comm=%s ksize=%zu usize=%zu\n",
+			current->comm, ksize, usize);
+	}
+	if (copy == 0)
+		return -EINVAL;
+	if (usize < ksize)
+		memset((u8 *)dst + copy, 0, ksize - copy);
+	if (copy_from_user(dst, src, copy))
+		return -EFAULT;
+	return 0;
+}
 #include "kgsl_timeline.h"
 #include "kgsl_trace.h"
 #include "kgsl_util.h"
@@ -536,7 +556,7 @@ drawobj_get_sync_timeline_priv(void __user *uptr, u64 usize, u32 count)
