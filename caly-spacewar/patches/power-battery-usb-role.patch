+
+static bool caly_is_fast_charger_type(u32 adap)
+{
+	switch (adap) {
+	case POWER_SUPPLY_USB_TYPE_DCP:
+	case POWER_SUPPLY_USB_TYPE_C:
+	case POWER_SUPPLY_USB_TYPE_PD:
+	case POWER_SUPPLY_USB_TYPE_PD_DRP:
+	case POWER_SUPPLY_USB_TYPE_PD_PPS:
+	case POWER_SUPPLY_USB_TYPE_APPLE_BRICK_ID:
+	case QTI_POWER_SUPPLY_USB_TYPE_HVDCP:
+	case QTI_POWER_SUPPLY_USB_TYPE_HVDCP_3:
+	case QTI_POWER_SUPPLY_USB_TYPE_HVDCP_3P5:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool caly_is_data_capable_charger(u32 adap)
+{
+	switch (adap) {
+	case POWER_SUPPLY_USB_TYPE_SDP:
+	case POWER_SUPPLY_USB_TYPE_CDP:
+	case POWER_SUPPLY_USB_TYPE_PD:
+	case POWER_SUPPLY_USB_TYPE_PD_DRP:
+	case POWER_SUPPLY_USB_TYPE_C:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static void caly_sync_usb_role(struct battery_chg_dev *bcdev,
+			       struct psy_state *pst)
+{
+	struct device_node *np;
+	struct usb_role_switch *sw;
+	enum usb_role target = USB_ROLE_NONE;
+	u32 online = 0, adap = 0, scope = 0;
+
+	if (!bcdev || !pst || !pst->prop)
+		return;
+
+	if (read_property_id(bcdev, pst, USB_ONLINE) == 0)
+		online = pst->prop[USB_ONLINE];
+	if (read_property_id(bcdev, pst, USB_ADAP_TYPE) == 0)
+		adap = pst->prop[USB_ADAP_TYPE];
+	if (read_property_id(bcdev, pst, USB_SCOPE) == 0)
+		scope = pst->prop[USB_SCOPE];
+
+	if (online && caly_is_fast_charger_type(adap)) {
+		if (bcdev->usb_icl_ua[USB_1_PORT_ID] != 0 ||
+		    !caly_icl_unvoted || adap != caly_last_adap) {
+			if (adap == POWER_SUPPLY_USB_TYPE_PD ||
+			    adap == POWER_SUPPLY_USB_TYPE_PD_DRP ||
+			    adap == POWER_SUPPLY_USB_TYPE_PD_PPS)
+				write_property_id(bcdev, pst, USB_INPUT_CURR_LIMIT, UINT_MAX);
+			bcdev->usb_icl_ua[USB_1_PORT_ID] = 0;
+			caly_icl_unvoted = true;
+			dev_info(bcdev->dev, "CALY_USB_BC: fast charger detected adap=%u\n", adap);
+		}
+	} else if (!online && adap == POWER_SUPPLY_USB_TYPE_UNKNOWN) {
+		caly_icl_unvoted = false;
+		if (bcdev->usb_icl_ua[USB_1_PORT_ID] != 0) {
+			write_property_id(bcdev, pst, USB_INPUT_CURR_LIMIT, UINT_MAX);
+			bcdev->usb_icl_ua[USB_1_PORT_ID] = 0;
+		}
+	}
+	caly_last_adap = adap;
+
+	if (scope == POWER_SUPPLY_SCOPE_SYSTEM) {
+		target = USB_ROLE_HOST;
+	} else if (online && caly_is_data_capable_charger(adap)) {
+		target = USB_ROLE_DEVICE;
+	} else {
+		target = USB_ROLE_NONE;
+	}
+
+	if (caly_role_ever_set && target == caly_last_role)
+		return;
+
+	np = of_find_compatible_node(NULL, NULL, "qcom,dwc-usb3-msm");
+	if (!np)
+		return;
+	sw = usb_role_switch_find_by_fwnode(of_fwnode_handle(np));
+	of_node_put(np);
+	if (!sw)
+		return;
+
+	dev_info(bcdev->dev, "CALY_USB_BC: online=%u adap=%u scope=%u -> role=%d\n",
+		 online, adap, scope, target);
+	caly_last_role = target;
+	caly_role_ever_set = true;
+	usb_role_switch_set_role(sw, target);
+	usb_role_switch_put(sw);
+}
