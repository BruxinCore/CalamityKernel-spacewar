+static int caly_legacy_do_invoke(struct fastrpc_user *fl,
+				 struct caly_legacy_invoke *inv,
+				 int __user *ufds,
+				 unsigned int __user *uattrs,
+				 unsigned int __user *ucrc,
+				 u64 __user *uperf_k,
+				 u64 __user *uperf_d)
+{
+	struct fastrpc_enhanced_invoke ioctl = { 0 };
+	union caly_remote_arg *pra = NULL;
+	struct fastrpc_invoke_args *kargs = NULL;
+	int *kfds = NULL;
+	unsigned int *kattrs = NULL;
+	int nscalars, nbufs, i, err = 0;
+
+	nscalars = REMOTE_SCALARS_LENGTH(inv->sc);
+	nbufs = REMOTE_SCALARS_INBUFS(inv->sc) + REMOTE_SCALARS_OUTBUFS(inv->sc);
+
+	if (nscalars > 0) {
+		if (nscalars > 128)
+			return -EINVAL;
+		pra = kcalloc(nscalars, sizeof(*pra), GFP_KERNEL);
+		kargs = kcalloc(nscalars, sizeof(*kargs), GFP_KERNEL);
+		if (!pra || !kargs) {
+			err = -ENOMEM;
+			goto out;
+		}
+		if (copy_from_user(pra, inv->pra, nscalars * sizeof(*pra))) {
+			err = -EFAULT;
+			goto out;
+		}
+		if (ufds) {
+			kfds = kcalloc(nscalars, sizeof(*kfds), GFP_KERNEL);
+			if (!kfds) {
+				err = -ENOMEM;
+				goto out;
+			}
+			if (copy_from_user(kfds, ufds, nscalars * sizeof(*kfds))) {
+				err = -EFAULT;
+				goto out;
+			}
+		}
+		if (uattrs) {
+			kattrs = kcalloc(nscalars, sizeof(*kattrs), GFP_KERNEL);
+			if (!kattrs) {
+				err = -ENOMEM;
+				goto out;
+			}
+			if (copy_from_user(kattrs, uattrs, nscalars * sizeof(*kattrs))) {
+				err = -EFAULT;
+				goto out;
+			}
+		}
+		for (i = 0; i < nbufs; i++) {
+			kargs[i].ptr = (u64)(uintptr_t)pra[i].buf.pv;
+			kargs[i].length = (u64)pra[i].buf.len;
+			kargs[i].fd = (kfds && kfds[i] > 0) ? kfds[i] : -1;
+			kargs[i].attr = kattrs ? kattrs[i] : 0;
+		}
+		for (i = nbufs; i < nscalars; i++) {
+			kargs[i].fd = pra[i].dma.fd;
+			kargs[i].ptr = (u64)pra[i].dma.offset;
+			kargs[i].length = (u64)pra[i].buf.len;
+			kargs[i].attr = kattrs ? kattrs[i] : 0;
+		}
+	}
+
+	ioctl.inv.handle = inv->handle;
+	ioctl.inv.sc = inv->sc;
+	ioctl.inv.args = (u64)(uintptr_t)kargs;
+	ioctl.crc = (u64)(uintptr_t)ucrc;
+	ioctl.perf_kernel = (u64)(uintptr_t)uperf_k;
+	ioctl.perf_dsp = (u64)(uintptr_t)uperf_d;
+	ioctl.reserved[19] = 0x43414C59U;
+
+	err = fastrpc_internal_invoke(fl, USER_MSG, &ioctl);
+
+out:
+	kfree(kattrs);
+	kfree(kfds);
+	kfree(kargs);
+	kfree(pra);
+	return err;
+}
