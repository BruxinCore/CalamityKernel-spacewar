+int fastrpc_legacy_device_register(struct device *dev, struct fastrpc_channel_ctx *cctx,
+				   bool is_secured, const char *name)
+{
+	struct fastrpc_device_node *fdev;
+	int err;
+
+	fdev = devm_kzalloc(dev, sizeof(*fdev), GFP_KERNEL);
+	if (!fdev)
+		return -ENOMEM;
+
+	fdev->secure = true;
+	fdev->is_legacy = true;
+	fdev->cctx = cctx;
+	fdev->miscdev.minor = MISC_DYNAMIC_MINOR;
+	fdev->miscdev.mode = 0666;
+	fdev->miscdev.fops = &fastrpc_fops;
+	fdev->miscdev.name = devm_kstrdup(dev, name, GFP_KERNEL);
+	if (!fdev->miscdev.name)
+		return -ENOMEM;
+
+	err = misc_register(&fdev->miscdev);
+	if (!err) {
+		if (is_secured)
+			cctx->legacy_secure_fdevice = fdev;
+		else
+			cctx->legacy_fdevice = fdev;
+		dev_info(dev, "CALY_FASTRPC: registered legacy /dev/%s (domain=%d)\n",
+			 name, cctx->domain_id);
+	}
+	return err;
+}
