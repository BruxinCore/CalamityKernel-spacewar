+static int caly_legacy_adsprpc_ioctl(struct fastrpc_user *fl, unsigned int cmd,
+				     char __user *argp, int *process_init)
+{
+	int err = 0;
+
+	switch (cmd) {
+	case CALY_LEG_INVOKE: {
+		struct caly_legacy_invoke inv;
+
+		if (copy_from_user(&inv, argp, sizeof(inv)))
+			return -EFAULT;
+		err = caly_legacy_do_invoke(fl, &inv, NULL, NULL, NULL, NULL, NULL);
+		break;
+	}
+	case CALY_LEG_INVOKE_FD: {
+		struct caly_legacy_invoke_fd inv;
+
+		if (copy_from_user(&inv, argp, sizeof(inv)))
+			return -EFAULT;
+		err = caly_legacy_do_invoke(fl, &inv.inv, inv.fds, NULL, NULL, NULL, NULL);
+		break;
+	}
+	case CALY_LEG_INVOKE_ATTRS: {
+		struct caly_legacy_invoke_attrs inv;
+
+		if (copy_from_user(&inv, argp, sizeof(inv)))
+			return -EFAULT;
+		err = caly_legacy_do_invoke(fl, &inv.inv, inv.fds, inv.attrs, NULL, NULL, NULL);
+		break;
+	}
+	case CALY_LEG_INVOKE_CRC: {
+		struct caly_legacy_invoke_crc inv;
+
+		if (copy_from_user(&inv, argp, sizeof(inv)))
+			return -EFAULT;
+		err = caly_legacy_do_invoke(fl, &inv.inv, inv.fds, inv.attrs, inv.crc, NULL, NULL);
+		break;
+	}
+	case CALY_LEG_INVOKE_PERF: {
+		struct caly_legacy_invoke_perf inv;
+
+		if (copy_from_user(&inv, argp, sizeof(inv)))
+			return -EFAULT;
+		err = caly_legacy_do_invoke(fl, &inv.inv, inv.fds, inv.attrs, inv.crc,
+					    inv.perf_kernel, inv.perf_dsp);
+		break;
+	}
+	case CALY_LEG_GETINFO: {
+		u32 info = 0;
+
+		if (copy_from_user(&info, argp, sizeof(info)))
+			return -EFAULT;
+		err = caly_legacy_switch_domain(fl, info);
+		if (err)
+			return err;
+		info = 1;
+		if (copy_to_user(argp, &info, sizeof(info)))
+			return -EFAULT;
+		break;
+	}
+	case CALY_LEG_SETMODE: {
+		u32 mode = 0;
+
+		if (copy_from_user(&mode, argp, sizeof(mode)))
+			return -EFAULT;
+		err = 0;
+		break;
+	}
+	case CALY_LEG_CONTROL: {
+		struct caly_legacy_control cp;
+
+		if (copy_from_user(&cp, argp, sizeof(cp)))
+			return -EFAULT;
+		if (cp.req == FASTRPC_CONTROL_KALLOC) {
+			cp.kalloc.kalloc_support = 1;
+			if (copy_to_user(argp, &cp, sizeof(cp)))
+				return -EFAULT;
+		}
+		err = 0;
+		break;
+	}
+	case CALY_LEG_GET_DSP_INFO: {
+		struct caly_legacy_capability lcap = { 0 };
+		struct fastrpc_ioctl_capability kcap = { 0 };
+
+		if (copy_from_user(&lcap, argp, sizeof(lcap)))
+			return -EFAULT;
+		if (lcap.attribute_id == FASTRPC_MAX_DSP_ATTRIBUTES) {
+			lcap.capability = 0;
+		} else if (lcap.attribute_id == FASTRPC_MAX_DSP_ATTRIBUTES + 1) {
+			lcap.capability = 1;
+		} else if (lcap.attribute_id < FASTRPC_MAX_DSP_ATTRIBUTES) {
+			kcap.domain = lcap.domain;
+			kcap.attribute_id = lcap.attribute_id;
+			err = fastrpc_get_info_from_kernel(&kcap, fl);
+			if (err)
+				return err;
+			lcap.capability = kcap.capability;
+		} else {
+			return -EOVERFLOW;
+		}
+		if (copy_to_user(argp, &lcap, sizeof(lcap)))
+			return -EFAULT;
+		break;
+	}
+	case CALY_LEG_INIT:
+	case CALY_LEG_INIT_ATTRS: {
+		struct caly_legacy_init_attrs ia = { 0 };
+		size_t sz = (cmd == CALY_LEG_INIT) ? sizeof(ia.init) : sizeof(ia);
+
+		if (copy_from_user(&ia, argp, sz))
+			return -EFAULT;
+		switch (ia.init.flags) {
+		case CALY_LEG_INIT_ATTACH:
+			fl->pd_type = ROOT_PD;
+			fl->sharedcb = false;
+			err = fastrpc_init_attach(fl, ROOT_PD);
+			if (!err) {
+				fastrpc_send_cpuinfo_to_dsp(fl);
+				*process_init = 1;
+			}
+			break;
+		case CALY_LEG_INIT_ATTACH_SENSORS:
+			fl->pd_type = SENSORS_STATICPD;
+			fl->sharedcb = true;
+			err = fastrpc_init_attach(fl, SENSORS_STATICPD);
+			if (!err)
+				*process_init = 1;
+			break;
+		case CALY_LEG_INIT_CREATE_STATIC: {
+			struct fastrpc_init_create_static ks = { 0 };
+
+			ks.namelen = ia.init.filelen;
+			ks.memlen = ia.init.memlen;
+			ks.name = (u64)ia.init.file;
+			err = fastrpc_init_create_static_process_impl(fl, ks);
+			if (!err)
+				*process_init = 1;
+			break;
+		}
+		case CALY_LEG_INIT_CREATE: {
+			struct fastrpc_init_create kc = { 0 };
+
+			fl->pd_type = USERPD;
+			fl->sharedcb = false;
+			kc.filelen = ia.init.filelen;
+			kc.filefd = ia.init.filefd;
+			kc.attrs = (u32)ia.attrs;
+			kc.siglen = ia.siglen;
+			kc.file = (u64)ia.init.file;
+			err = fastrpc_init_create_process_impl(fl, kc);
+			if (!err)
+				*process_init = 1;
+			break;
+		}
+		default:
+			err = -EINVAL;
+			break;
+		}
+		dev_info(fl->cctx->dev, "CALY_LEG_INIT: comm=%s dom=%d flags=%u pd=%u sh=%d err=%d\n",
+			 current->comm, fl->cctx->domain_id, ia.init.flags, fl->pd_type, fl->sharedcb, err);
+		break;
+	}
+	case CALY_LEG_MMAP: {
+		struct caly_legacy_mmap lm;
+		struct fastrpc_req_mmap km = { 0 };
+
+		if (copy_from_user(&lm, argp, sizeof(lm)))
+			return -EFAULT;
+		km.fd = lm.fd;
+		km.flags = lm.flags;
+		km.vaddrin = (u64)lm.vaddrin;
+		km.size = (u64)lm.size;
+		mutex_lock(&fl->remote_map_mutex);
+		err = fastrpc_req_mmap_k(fl, &km);
+		mutex_unlock(&fl->remote_map_mutex);
+		if (err)
+			return err;
+		lm.vaddrout = (uintptr_t)km.vaddrout;
+		if (copy_to_user(argp, &lm, sizeof(lm)))
+			return -EFAULT;
+		break;
+	}
+	case CALY_LEG_MMAP_64: {
+		struct caly_legacy_mmap_64 lm;
+		struct fastrpc_req_mmap km = { 0 };
+
+		if (copy_from_user(&lm, argp, sizeof(lm)))
+			return -EFAULT;
+		km.fd = lm.fd;
+		km.flags = lm.flags;
+		km.vaddrin = lm.vaddrin;
+		km.size = (u64)lm.size;
+		mutex_lock(&fl->remote_map_mutex);
+		err = fastrpc_req_mmap_k(fl, &km);
+		mutex_unlock(&fl->remote_map_mutex);
+		if (err)
+			return err;
+		lm.vaddrout = km.vaddrout;
+		if (copy_to_user(argp, &lm, sizeof(lm)))
+			return -EFAULT;
+		break;
+	}
+	case CALY_LEG_MUNMAP: {
+		struct caly_legacy_munmap lum;
+		struct fastrpc_req_munmap kum = { 0 };
+
+		if (copy_from_user(&lum, argp, sizeof(lum)))
+			return -EFAULT;
+		kum.vaddrout = (u64)lum.vaddrout;
+		kum.size = (u64)lum.size;
+		mutex_lock(&fl->remote_map_mutex);
+		err = fastrpc_req_munmap_k(fl, &kum);
+		mutex_unlock(&fl->remote_map_mutex);
+		break;
+	}
+	case CALY_LEG_MUNMAP_64: {
+		struct caly_legacy_munmap_64 lum;
+		struct fastrpc_req_munmap kum = { 0 };
+
+		if (copy_from_user(&lum, argp, sizeof(lum)))
+			return -EFAULT;
+		kum.vaddrout = lum.vaddrout;
+		kum.size = (u64)lum.size;
+		mutex_lock(&fl->remote_map_mutex);
+		err = fastrpc_req_munmap_k(fl, &kum);
+		mutex_unlock(&fl->remote_map_mutex);
+		break;
+	}
+	case CALY_LEG_MUNMAP_FD: {
+		struct caly_legacy_munmap_fd lfd;
+		struct fastrpc_map *map = NULL;
+
+		if (copy_from_user(&lfd, argp, sizeof(lfd)))
+			return -EFAULT;
+		mutex_lock(&fl->map_mutex);
+		if (!fastrpc_map_lookup(fl, lfd.fd, (u64)lfd.va, (u64)lfd.len, NULL, 0, &map, false) && map)
+			fastrpc_map_put(map);
+		mutex_unlock(&fl->map_mutex);
+		err = 0;
+		break;
+	}
+	case CALY_LEG_MEM_MAP: {
+		struct caly_legacy_mem_map lm;
+		struct fastrpc_mem_map km = { 0 };
+
+		if (copy_from_user(&lm, argp, sizeof(lm)))
+			return -EFAULT;
+		km.version = lm.version;
+		km.fd = lm.m.fd;
+		km.offset = lm.m.offset;
+		km.flags = lm.m.flags;
+		km.vaddrin = (u64)lm.m.vaddrin;
+		km.length = (u64)lm.m.length;
+		km.attrs = lm.m.attrs;
+		err = fastrpc_req_mem_map_k(fl, &km);
+		if (err)
+			return err;
+		lm.m.vaddrout = km.vaddrout;
+		if (copy_to_user(argp, &lm, sizeof(lm)))
+			return -EFAULT;
+		break;
+	}
+	case CALY_LEG_MEM_UNMAP: {
+		struct caly_legacy_mem_unmap lum;
+		struct fastrpc_mem_unmap kum = { 0 };
+
+		if (copy_from_user(&lum, argp, sizeof(lum)))
+			return -EFAULT;
+		kum.vesion = lum.version;
+		kum.fd = lum.um.fd;
+		kum.vaddr = lum.um.vaddr;
+		kum.length = (u64)lum.um.length;
+		err = fastrpc_req_mem_unmap_impl(fl, &kum);
+		break;
+	}
+	case CALY_LEG_INVOKE2: {
+		struct caly_legacy_invoke2 inv2;
+
+		if (copy_from_user(&inv2, argp, sizeof(inv2)))
+			return -EFAULT;
+		if (inv2.req == 3)
+			err = 0;
+		else
+			err = -ENOTTY;
+		break;
+	}
+	default:
+		dev_warn_ratelimited(fl->cctx->dev, "CALY_LEG_IOCTL unknown cmd=0x%x nr=%u sz=%u\n",
+				     cmd, _IOC_NR(cmd), _IOC_SIZE(cmd));
+		err = -ENOTTY;
+		break;
+	}
+	return err;
+}
