+static int caly_legacy_switch_domain(struct fastrpc_user *fl, u32 cid)
+{
+	struct fastrpc_channel_ctx *old_cctx = fl->cctx;
+	struct fastrpc_channel_ctx *new_cctx = NULL;
+	unsigned long irq_flags, flags;
+	int new_tgid;
+
+	if (cid >= FASTRPC_DEV_MAX)
+		return -EINVAL;
+	if (old_cctx && old_cctx->domain_id == (int)cid)
+		return 0;
+
+	spin_lock_irqsave(&g_frpc.glock, irq_flags);
+	new_cctx = g_frpc.gctx[cid];
+	if (new_cctx && !atomic_read(&new_cctx->teardown))
+		fastrpc_channel_ctx_get(new_cctx);
+	else
+		new_cctx = NULL;
+	spin_unlock_irqrestore(&g_frpc.glock, irq_flags);
+
+	if (!new_cctx)
+		return -ENODEV;
+
+	new_tgid = get_unique_hlos_process_id(new_cctx);
+	if (new_tgid == -1) {
+		fastrpc_channel_ctx_put(new_cctx);
+		return -EUSERS;
+	}
+
+	spin_lock_irqsave(&old_cctx->lock, flags);
+	list_del_init(&fl->user);
+	spin_unlock_irqrestore(&old_cctx->lock, flags);
+
+	if (fl->tgid_frpc != -1)
+		ida_free(&old_cctx->tgid_frpc_ida,
+			 fl->tgid_frpc - (old_cctx->domain_id * FASTRPC_UNIQUE_ID_CONST));
+
+	fl->cctx = new_cctx;
+	fl->tgid_frpc = new_tgid;
+
+	spin_lock_irqsave(&new_cctx->lock, flags);
+	list_add_tail(&fl->user, &new_cctx->users);
+	spin_unlock_irqrestore(&new_cctx->lock, flags);
+
+	fastrpc_channel_ctx_put(old_cctx);
+	return 0;
+}
