diff --git a/msm/msm_drv.c b/msm/msm_drv.c
index 1d6f7c5..3891674 100644
--- a/msm/msm_drv.c
+++ b/msm/msm_drv.c
@@ -158,12 +158,19 @@ static int msm_atomic_check(struct drm_device *dev,
 {
 	struct msm_drm_private *priv;
 
-	priv = dev->dev_private;
-	if (priv && priv->kms && priv->kms->funcs &&
-			priv->kms->funcs->atomic_check)
-		return priv->kms->funcs->atomic_check(priv->kms, state);
-
-	return drm_atomic_helper_check(dev, state);
+	{
+		int ret;
+		static atomic_t caly_chk_cnt = ATOMIC_INIT(25);
+		priv = dev->dev_private;
+		if (priv && priv->kms && priv->kms->funcs &&
+				priv->kms->funcs->atomic_check)
+			ret = priv->kms->funcs->atomic_check(priv->kms, state);
+		else
+			ret = drm_atomic_helper_check(dev, state);
+		if (ret || atomic_dec_if_positive(&caly_chk_cnt) >= 0)
+			pr_emerg("CALY_DRM: atomic_check ret=%d comm=%s\n", ret, current->comm);
+		return ret;
+	}
 }
 
 static const struct drm_mode_config_funcs mode_config_funcs = {
@@ -1844,6 +1851,24 @@ static const struct drm_ioctl_desc msm_ioctls[] = {
 			DRM_UNLOCKED),
 };
 
+static long caly_drm_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
+{
+	long ret = drm_ioctl(filp, cmd, arg);
+	unsigned int nr = _IOC_NR(cmd);
+	if (ret < 0) {
+		static atomic_t fail_cnt = ATOMIC_INIT(60);
+		if (atomic_dec_if_positive(&fail_cnt) >= 0)
+			pr_emerg("CALY_DRM_IOCTL FAIL comm=%s cmd=0x%x nr=0x%x ret=%ld\n",
+				current->comm, cmd, nr, ret);
+	} else if (nr == 0x2e || nr == 0x3a || nr == 0xb8 || nr == 0xbc || (nr >= 0x40 && nr < 0x80)) {
+		static atomic_t ok_cnt = ATOMIC_INIT(30);
+		if (atomic_dec_if_positive(&ok_cnt) >= 0)
+			pr_emerg("CALY_DRM_IOCTL OK comm=%s cmd=0x%x nr=0x%x\n",
+				current->comm, cmd, nr);
+	}
+	return ret;
+}
+
 static const struct file_operations fops = {
 	.owner              = THIS_MODULE,
 	.open               = drm_open,
@@ -1851,7 +1876,7 @@ static const struct file_operations fops = {
 #if (KERNEL_VERSION(6, 10, 0) <= LINUX_VERSION_CODE)
 	.fop_flags          = FOP_UNSIGNED_OFFSET,
 #endif
-	.unlocked_ioctl     = drm_ioctl,
+	.unlocked_ioctl     = caly_drm_ioctl,
 	.compat_ioctl       = drm_compat_ioctl,
 	.poll               = drm_poll,
 	.read               = drm_read,
