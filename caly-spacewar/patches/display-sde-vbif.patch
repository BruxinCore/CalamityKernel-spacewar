+				readl_relaxed(b + 0x48), readl_relaxed(b + 0x4c),
+				readl_relaxed(b + 0xa8), readl_relaxed(b + 0x11c));
+		}
 	}
 	SDE_EVT32(dsi_ctrl->cell_index, SDE_EVTLOG_FUNC_EXIT);
 
